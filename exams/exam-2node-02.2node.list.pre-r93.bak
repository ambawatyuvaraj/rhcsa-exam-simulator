# RHCSA two-node exam 02 — format: "<node> <task-id>"  (node1 | node2)
# Distinct single-node tasks from exam-01; same cross-node server↔client pairs.

# ---- node1 : servers + independent tasks ----
node1 nfs-export
node1 repo-server
node1 ntp-server
node1 ssh-key-peer
node1 rsync-peer
node1 user-create-comment
node1 find-name-type
node1 lv-create-bysize
node1 cron-weekday
node1 tar-xz
node1 sed-replace
node1 package-install
node1 sysctl-set
node1 service-enable
node1 password-hash

# ---- node2 : clients + independent tasks ----
node2 root-password   # ALWAYS FIRST on node2 — like the real exam (lost root password, console boot-interruption)
node2 ssh-key-target
node2 nfs-mount-peer
node2 autofs-peer
node2 repo-client
node2 ntp-client
node2 group-gid
node2 skel-file
node2 acl-default
node2 selinux-boolean
node2 script-loop
node2 container-run
node2 mkfs-xfs
node2 password-aging
node2 network-route
node2 journal-find

# RHCSA_RHEL: 9   (this paper reproduces a RHEL 9 EX200 exam; contains containers/set-GID/MBR tasks that RHEL 10 objectives dropped)
# RHCSA two-node exam 01 — faithful reproduction of "RHCSA RHEL 9 Exam Answers"
# (rchsa_9.pdf). Node1 = the system you configure (19 tasks); Node2 = the system
# you reset (root password first) then configure storage/tuned (6 tasks).
# Values are from the answer key; only setup-specifics are adapted to this 2-VM
# offline lab (IPs on the isolated dummy NIC rhcsa0; repos point at the local
# DVD; the NFS source is localhost; node2's swap+LVM share ONE disk like the
# key's /dev/vdb part3=swap + part2=LVM).
# format: "<node> <task-id>"   (trailing "# Qn" maps to the answer-key question)

# ---- node1 : 19 tasks ----
node1 e1-network       # Q1   hostname node1.lab.network17.com + static IP 172.25.250.11
node1 e1-repo          # Q2   /etc/yum.repos.d/app.repo (BaseOS + AppStream)
node1 selinux-port     # Q3   web server on non-standard port 82
node1 e1-users         # Q4   group admin; harry+natasha in admin; sarah nologin; pw 123
node1 e1-collab        # Q5   collaborative set-GID dir /common/admin (2770)
node1 e1-autofs        # Q6   automount production5's home via autofs (/localhome)
node1 e1-cron          # Q7   cron job for harry at 12:30 (echo hello)
node1 chrony-iburst    # Q8   NTP client (server ... iburst)
node1 e1-findowner     # Q9   find files owned by sarah -> /root/find.user
node1 e1-grephome      # Q10  grep "home" /etc/passwd -> /root/search.txt
node1 e1-uid           # Q11  create user alies with UID 1326
node1 e1-backup        # Q12  gzip tar archive of /var/tmp -> /root/test.tar.gz
node1 f08-cbuild       # Q13  build the container image 'monitor' as walhalla
node1 e1-cservice      # Q14  rootless container ascii2pdf as a systemd user service
node1 e1-umask         # Q15  per-user umask 277 for natasha (16.1)
node1 e1-passmax       # Q16  PASS_MAX_DAYS 20 in /etc/login.defs (16.2)
node1 f08-sudo         # Q17  passwordless sudo for group admin (16.3)
node1 e1-envvar        # Q18  env var RHCSA for alies (16.4)
node1 e1-script        # Q19  /usr/local/bin/mysearch finds <1M files (16.5)

# ---- node2 : 6 tasks ----
node2 root-password    # Q1   ALWAYS FIRST on node2 — reset the lost root password (console)
node2 e1-repo2         # Q2   /etc/yum.repos.d/app.repo (BaseOS + AppStream)
node2 e1-swap          # Q3   512 MiB swap partition (shared disk, part 3)
node2 e1-lvm           # Q4   VG datastore (8M PE) + LV database (50 ext, ext3, /mnt/database)
node2 e1-lvresize      # Q5   extend database to 100 extents
node2 tuning-profile   # Q7   set the recommended tuned profile (virtual-guest)
